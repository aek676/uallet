{
  "name": "uallet",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalogs": {
      "lint": {
        "oxlint": "1.90.0",
        "oxlint-tsgolint": "7.0.2005"
      },
      "build": {
        "typescript": "7.0.2",
        "vite": "8.2.2"
      }
    }
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "oxfmt": "0.76.0",
    "oxlint": "catalog:lint",
    "oxlint-tsgolint": "catalog:lint",
    "turbo": "^2.11.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.4"
    }
  },
  "engines": {
    "node": ">=24.20.0"
  }
}
