{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".env*"],
  "globalPassThroughEnv": ["VARLOCK_TELEMETRY_DISABLED"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["APP_ENV", "VITE_*"],
      "outputs": ["dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "codegen": {
      "inputs": [".env.schema"],
      "outputs": ["env.d.ts"]
    },
    "lint": {
      "dependsOn": ["transit", "codegen"]
    },
    "lint:fix": {
      "cache": false
    },
    "//#format": {},
    "//#format:fix": {
      "cache": false
    },
    "dev": {
      "env": ["APP_ENV"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["transit"]
    }
  }
}
