{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".env*"],
  "globalPassThroughEnv": [
    "VARLOCK_TELEMETRY_DISABLED",
    "CLAUDE_CODE_SESSION_ID",
    "CLAUDE_SESSION_ID",
    "CODEX_THREAD_ID"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "env": ["APP_ENV", "VITE_*"],
      "outputs": ["dist/**"]
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "codegen": {
      "inputs": [
        ".env.schema",
        "$TURBO_ROOT$/packages/i18n/project.inlang/**",
        "$TURBO_ROOT$/packages/i18n/messages/**"
      ],
      "outputs": ["env.d.ts", "src/paraglide/**"]
    },
    "lint": {
      "dependsOn": ["transit", "codegen"]
    },
    "lint:fix": {
      "cache": false
    },
    "//#format": {},
    "//#format:fix": {
      "cache": false
    },
    "dev": {
      "env": ["APP_ENV"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["transit"]
    }
  }
}
