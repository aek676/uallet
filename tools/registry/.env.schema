# @import(../../, pick=[APP_ENV, INFISICAL_*])
# @defaultSensitive=false @defaultRequired=infer
# @generateTsTypes(path=./env.d.ts, icons=false)
# ---

# Solana devnet RPC. The same Infisical secret the apps read.
# @type=url(allowedProtocols=[https, http])
SOLANA_RPC_URL=infisical()

# Keypair file (`solana-keygen` JSON) of the registry's credential authority,
# which signs every registration. Outside the repo; `~` is your home. Only
# `registry:init`, `merchant:add` and `merchant:remove` read it.
REGISTRY_AUTHORITY_KEYPAIR=~/.config/uallet/mi-autoridad.json
