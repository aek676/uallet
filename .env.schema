# @defaultSensitive=false @defaultRequired=infer
# @currentEnv=$APP_ENV
# @plugin(@varlock/infisical-plugin)
# @initInfisical(
#   projectId=6f9e1464-84b3-40e1-895f-a324f848ee10,
#   environment=dev,
#   clientId=$INFISICAL_CLIENT_ID,
#   clientSecret=$INFISICAL_CLIENT_SECRET,
#   cacheTtl="1h"
# )
# ---

# Selects which .env.[APP_ENV] files are loaded. `test` is set by the test
# scripts and CI.
# @type=enum(development, test)
APP_ENV=development

# Infisical machine identity (Universal Auth) with read-only access to `dev`.
# @type=infisicalClientId
INFISICAL_CLIENT_ID=bc9416c6-12b4-4a2b-a1ed-41e311542ac6

# Set it in your .env.local as `varlock(prompt)` and run
# `aube exec varlock load`: it is stored encrypted for this device.
# @type=infisicalClientSecret @sensitive @internal @required=forEnv(development)
INFISICAL_CLIENT_SECRET=

# Solana devnet RPC. Dedicated RPCs (Helius, Triton...) embed an API key in the
# URL: restrict it to your domains in the provider's dashboard.
# @type=url(allowedProtocols=[https, http])
# @example="https://api.devnet.solana.com"
VITE_SOLANA_RPC_URL=infisical("SOLANA_RPC_URL")

# Solana devnet WebSocket, to listen for confirmations and payments.
# @type=url(allowedProtocols=[wss, ws])
# @example="wss://api.devnet.solana.com"
VITE_SOLANA_WS_URL=infisical("SOLANA_WS_URL")

# Port the API
# @type=port
API_PORT=5177

# Public URL of the API (apps/api), without a trailing slash. The only source
# of where the API is: the QR's payment endpoint (`VITE_PAYMENT_REQUEST_URL`)
# and the wallet's API URL (`VITE_API_URL`) are derived from it, so they can't
# point to different servers. HTTPS, as Solana Pay requires for the endpoint;
# plain `http` only to `localhost`, `127.0.0.1` or `[::1]`, for dev. No query
# or hash. In `regex()`, `\.` is written with a single backslash.
# @type=url(allowedProtocols=[https, http], matches=regex("^(https://[^/?#]+|http://(localhost|127\.0\.0\.1|\[::1\])(:\d+)?)(/[^?#]*[^/?#])?$"))
API_PUBLIC_URL=http://localhost:${API_PORT}

# The API's payment endpoint (`POST /pay`): the merchant puts it in the QR, as
# a Solana Pay transaction request, and the wallet only pays links to it.
# Derived from `API_PUBLIC_URL`: don't set it.
# @type=url
VITE_PAYMENT_REQUEST_URL=${API_PUBLIC_URL}/pay
