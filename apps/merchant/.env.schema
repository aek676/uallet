# Wallet that receives the payments (a Solana address). Use a different one
# from the student wallet you pay with. To use your own, override it in
# apps/merchant/.env.local.
# @type=string(matches=regex("^[1-9A-HJ-NP-Za-km-z]{32,44}$"))
VITE_MERCHANT_ADDRESS=infisical("MERCHANT_ADDRESS")

# Shown to the student when paying.
# @type=string(maxLength=40)
VITE_MERCHANT_NAME=Cafetería Central
