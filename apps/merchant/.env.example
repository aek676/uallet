# Copy to `.env.local` (git-ignored) and fill in.
# Everything here ends up in the browser bundle: never put secrets in it.
# Both values are public anyway: they go in the payment QR code.

# Wallet that receives the payments (a Solana address). Use a different one
# from the student wallet you pay with, e.g. log in to the wallet app with
# another account and copy its address.
VITE_MERCHANT_ADDRESS=

# Shown to the student when paying. At most 40 characters.
VITE_MERCHANT_NAME=Cafetería Central
