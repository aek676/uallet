# @import(../../, pick=[APP_ENV, INFISICAL_*, VITE_SOLANA_*, API_PORT])
# @defaultSensitive=false @defaultRequired=infer
# @generateTsTypes(path=./env.d.ts, icons=false)
# ---

# MetaMask Embedded Wallets client ID (https://developer.metamask.io).
# Public by design: restrict the allowed origins in the dashboard.
VITE_WEB3AUTH_CLIENT_ID=infisical("WEB3AUTH_CLIENT_ID")

# Base URL of the API (`apps/api`). In dev, Vite proxies `/api` to the API on
# `localhost` (`API_PORT`, from the root schema). In production the API must be
# served under the same origin at this path, or the API needs CORS for the
# wallet's origin.
VITE_API_URL=/api
