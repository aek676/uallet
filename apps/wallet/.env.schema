# @import(../../, pick=[APP_ENV, INFISICAL_*, VITE_SOLANA_*, VITE_PAYMENT_REQUEST_URL, API_PUBLIC_URL, API_PORT])
# @defaultSensitive=false @defaultRequired=infer
# @generateTsTypes(path=./env.d.ts, icons=false)
# ---

# MetaMask Embedded Wallets client ID (https://developer.metamask.io).
# Public by design: restrict the allowed origins in the dashboard.
VITE_WEB3AUTH_CLIENT_ID=infisical("WEB3AUTH_CLIENT_ID")

# Where the wallet calls the API. Derived from `API_PUBLIC_URL` (root
# schema): don't set it. When the API is on `localhost` (dev), it is `/api`,
# which Vite proxies to it, so a phone reaches it too. Otherwise it is
# `API_PUBLIC_URL`, which then needs to be on the wallet's origin, or the API
# needs CORS for it.
VITE_API_URL=remap($API_PUBLIC_URL, regex("^http://(localhost|127\.0\.0\.1|\[::1\])(:\d+)?$"), "/api")
