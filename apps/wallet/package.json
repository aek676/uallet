{
  "name": "wallet",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": [
      "./src/*",
      "./src/*.ts",
      "./src/*.tsx"
    ]
  },
  "scripts": {
    "dev": "vite --clearScreen false",
    "build": "vite build",
    "preview": "vite preview",
    "codegen": "APP_ENV=test varlock codegen && paraglide-js compile --project ./project.inlang",
    "lint": "oxlint --type-aware --type-check",
    "lint:fix": "oxlint --type-aware --type-check --fix",
    "test": "APP_ENV=test vitest run"
  },
  "dependencies": {
    "@repo/payments": "workspace:*",
    "@repo/ui": "workspace:*",
    "@solana/kit": "catalog:solana",
    "@solana/kit-plugin-rpc": "catalog:solana",
    "@solana/kit-plugin-signer": "catalog:solana",
    "@solana/react": "catalog:solana",
    "@solana/wallet-account-signer": "catalog:solana",
    "@tanstack/react-form": "catalog:forms",
    "@tanstack/react-router": "catalog:router",
    "@wallet-standard/features": "catalog:wallet",
    "@wallet-standard/ui-registry": "catalog:solana",
    "@web3auth/no-modal": "catalog:wallet",
    "barcode-detector": "catalog:wallet",
    "lucide-react": "catalog:ui",
    "react": "catalog:react",
    "react-dom": "catalog:react",
    "sonner": "catalog:ui",
    "varlock": "catalog:env",
    "zod": "catalog:forms",
    "zxing-wasm": "catalog:wallet"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "catalog:i18n",
    "@inlang/plugin-message-format": "catalog:i18n",
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@tailwindcss/vite": "catalog:styles",
    "@tanstack/react-devtools": "catalog:devtools",
    "@tanstack/react-router-devtools": "catalog:router",
    "@tanstack/router-plugin": "catalog:router",
    "@types/react": "catalog:react",
    "@types/react-dom": "catalog:react",
    "@varlock/infisical-plugin": "catalog:env",
    "@varlock/vite-integration": "catalog:env",
    "@vitejs/plugin-react": "catalog:build",
    "oxlint": "catalog:lint",
    "oxlint-tsgolint": "catalog:lint",
    "tailwindcss": "catalog:styles",
    "typescript": "catalog:build",
    "vite": "catalog:build",
    "vitest": "catalog:test"
  }
}
