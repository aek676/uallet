# Copy to `.env.local` (git-ignored) and fill in.
# Everything here ends up in the browser bundle: never put secrets in it.

# MetaMask Embedded Wallets client ID (https://developer.metamask.io).
# Public by design: restrict the allowed origins in the dashboard.
VITE_WEB3AUTH_CLIENT_ID=

# Solana devnet RPC. Optional: defaults to the public, rate-limited endpoints.
# Dedicated RPCs (Helius, Triton...) embed an API key in the URL: restrict it
# to your domains in the provider's dashboard.
VITE_SOLANA_RPC_URL=
VITE_SOLANA_WS_URL=
