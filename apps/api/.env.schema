# Port the API listens on. Fixed, like the apps' (wallet 5173, merchant 5175).
# @type=port
API_PORT=5177

# Minimum level the logger writes. `silent` in tests (`.env.test`).
# @type=enum(trace, debug, info, warn, error, fatal, silent)
LOG_LEVEL=info
