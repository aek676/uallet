# @import(../../, pick=[APP_ENV, INFISICAL_*, API_PORT])
# @defaultSensitive=false @defaultRequired=infer
# @generateTsTypes(path=./env.d.ts, icons=false)
# ---

# Minimum level the logger writes. `silent` in tests (`.env.test`).
# @type=enum(trace, debug, info, warn, error, fatal, silent)
LOG_LEVEL=info

# MetaMask Embedded Wallets (Web3Auth) client ID: the audience the wallet's
# identity tokens must carry. All Web3Auth projects share the signing keys, so
# without this check any project's token would be accepted. The same public
# value the wallet uses: the same Infisical secret, `WEB3AUTH_CLIENT_ID`.
WEB3AUTH_CLIENT_ID=infisical()

# Web3Auth's signing keys for identity tokens (v11 SDK). Its docs still name
# `api-auth.web3auth.io`, which doesn't serve the v11 keys.
# @type=url(allowedProtocols=[https])
WEB3AUTH_JWKS_URL=https://api.web3auth.io/citadel-service/.well-known/jwks.json

# `iss` claim of Web3Auth identity tokens.
WEB3AUTH_ISSUER=web3auth.io

# Signs our sessions (HS256): 32 random bytes in base64url, no padding. Every
# instance must share it; a new key ends every session (the wallet opens a new
# one). Each environment needs its own key.
# @sensitive @type=string(matches=regex("^[A-Za-z0-9_-]{43}$"))
API_SESSION_KEY=infisical()

# Solana RPC, for the latest blockhash of each payment. The same Infisical
# secret the wallet and merchant read (`VITE_SOLANA_RPC_URL`, root schema).
# @type=url(allowedProtocols=[https, http])
SOLANA_RPC_URL=infisical()
