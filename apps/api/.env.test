# Values for tests and CI (APP_ENV=test). Public placeholders.
# ---

# Keep the test output free of request logs.
LOG_LEVEL=silent

WEB3AUTH_CLIENT_ID=test-web3auth-client-id

# 32 bytes, public: only for tests.
API_SESSION_KEY=test-session-key-not-a-secret-0000000000000

SOLANA_RPC_URL=https://api.devnet.solana.com
