{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    "./app": {
      "types": "./src/app.ts"
    }
  },
  "scripts": {
    "dev": "bun --watch src/index.ts | pino-pretty",
    "codegen": "APP_ENV=test varlock codegen",
    "lint": "oxlint --type-aware --type-check --deny-warnings --report-unused-disable-directives-severity=error",
    "lint:fix": "oxlint --type-aware --type-check --deny-warnings --report-unused-disable-directives-severity=error --fix",
    "test": "APP_ENV=test vitest run"
  },
  "dependencies": {
    "@bogeychan/elysia-logger": "catalog:api",
    "@solana/kit": "catalog:solana",
    "elysia": "catalog:api",
    "jose": "catalog:api",
    "pino": "catalog:api",
    "varlock": "catalog:env",
    "zod": "catalog:forms"
  },
  "devDependencies": {
    "@repo/oxlint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bun": "catalog:api",
    "@varlock/infisical-plugin": "catalog:env",
    "oxlint": "catalog:lint",
    "oxlint-tsgolint": "catalog:lint",
    "pino-pretty": "catalog:api",
    "typescript": "catalog:build",
    "vite": "catalog:build",
    "vitest": "catalog:test"
  },
  "engines": {
    "bun": ">=1.4.0 <1.5.0"
  }
}
